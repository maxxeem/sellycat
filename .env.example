# Sellycat environment variables. Copy to .env.local (never committed) and fill in.
# Vercel: Production = live values, Preview + Development = staging values.

# Public site URL. Production: https://sellycat.com, staging previews: https://staging.sellycat.com.
# Decides which host is the apex (login, dashboard, staff admin) and which are shops (<slug>.<host>).
NEXT_PUBLIC_SITE_URL=https://sellycat.com

# Supabase (Dashboard → Project Settings → API). .env.local points at STAGING.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>
# Server only (Vercel: sensitive). Supabase → Project Settings → API → secret key.
SUPABASE_SECRET_KEY=

# Local only: database tooling (scripts/db.mjs) and RLS tests.
SUPABASE_STAGING_REF=
SUPABASE_STAGING_DB_URL=
SUPABASE_PRODUCTION_REF=
SUPABASE_PRODUCTION_DB_URL=

# Staging only (Vercel Preview): password gate for staging.sellycat.com. Never set in Production.
STAGING_PASSWORD=

# Local / preview only: staff pages without authenticator (e2e). No effect in production.
PLATFORM_MFA_OPTIONAL=

# Vercel API: registers <slug>.sellycat.com and custom domains with the project (phase 1/6).
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Vercel Cron authentication (Authorization: Bearer <CRON_SECRET>) for /api/cron/*
CRON_SECRET=

# Seed (scripts/seed-staging.ts): demo owner and staff login on staging.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Mapbox (maps of redemption locations). Server token for geocoding; the public token (pk.…, restricted
# to your domains in Mapbox) appears in static map URLs. Without them the shop shows addresses and route links only.
MAPBOX_TOKEN=
MAPBOX_PUBLIC_TOKEN=

# Later phases (left empty until then):
# Stripe platform account (phase 3). Test keys on staging/local, live keys only in production.
# Developers → API keys:
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Connect → Settings → Onboarding options → OAuth: client id (ca_…); redirect URIs
# https://staging.sellycat.com/api/stripe/connect/callback and http://localhost:3000/api/stripe/connect/callback
STRIPE_CONNECT_CLIENT_ID=
# Webhook endpoint /api/stripe/webhook listening to "events on connected accounts" (whsec_…)
STRIPE_CONNECT_WEBHOOK_SECRET=
# Phase 7 (Sellycat subscriptions, Stripe Billing on the platform account): webhook endpoint
# https://<host>/api/stripe/billing (events of "Your account": checkout.session.completed,
# customer.subscription.created|updated|deleted, invoice.paid, invoice.payment_failed).
STRIPE_BILLING_WEBHOOK_SECRET=
# 1 = Stripe Tax computes VAT in the subscription checkout (only once Stripe Tax is set up).
STRIPE_TAX=
# Optional: enquiries from the pricing page ("Contact us") are also mailed here.
SALES_EMAIL=
# Recipient of the contact form (/contact); default hello@sellycat.com.
CONTACT_EMAIL=
# Optional Cloudflare Turnstile for the waitlist and contact forms (both keys, or neither).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Support: fallback address for new support requests when no staff member is chosen under /admin/support.
SUPPORT_EMAIL=
# Mailgun (phase 4, EU region): sending key of the domain
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mail.sellycat.com
MAILGUN_API_BASE=https://api.eu.mailgun.net
# Optional: Mailgun account key for shops' own sender domains (if MAILGUN_API_KEY is only a domain sending key).
MAILGUN_ACCOUNT_KEY=
# Apple Wallet (phase 5): APPLE_PASS_TYPE_ID, APPLE_TEAM_ID, APPLE_PASS_CERT, APPLE_PASS_KEY, APPLE_WWDR_CERT
# Google Wallet (phase 5): GOOGLE_WALLET_ISSUER_ID, GOOGLE_WALLET_SERVICE_ACCOUNT
# Sentry: SENTRY_DSN, NEXT_PUBLIC_SENTRY_DSN

# Wallet (Phase 5). Locally the keys are read from WALLET_KEYS_DIR (git-ignored folder
# sellycat-keys); on Vercel they are set as PEM text or base64 in the variables below.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_WWDR_CERT=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT=
GOOGLE_WALLET_KEY_ID=
GOOGLE_WALLET_PRIVATE_KEY=
WALLET_KEYS_DIR=

# Google Places API (New) for "Einlösbar bei": business search, address, opening hours.
# Server-side only; restrict the key to the Places API (New).
GOOGLE_PLACES_API_KEY=

# AI deal import from a product link (Claude). Server-side only.
ANTHROPIC_API_KEY=
