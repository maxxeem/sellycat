# Sellycat environment variables. Copy to .env.local (never committed) and fill in.
# Vercel: Production = live values, Preview + Development = staging values.

# Public site URL. Production: https://sellycat.com, staging previews: https://staging.sellycat.com.
# Decides which host is the apex (login, dashboard, staff admin) and which are shops (<slug>.<host>).
NEXT_PUBLIC_SITE_URL=https://sellycat.com

# Supabase (Dashboard → Project Settings → API). .env.local points at STAGING.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>
# Server only (Vercel: sensitive). Supabase → Project Settings → API → secret key.
SUPABASE_SECRET_KEY=

# Local only: database tooling (scripts/db.mjs) and RLS tests.
SUPABASE_STAGING_REF=
SUPABASE_STAGING_DB_URL=
SUPABASE_PRODUCTION_REF=
SUPABASE_PRODUCTION_DB_URL=

# Staging only (Vercel Preview): password gate for staging.sellycat.com. Never set in Production.
STAGING_PASSWORD=

# Local / preview only: staff pages without authenticator (e2e). No effect in production.
PLATFORM_MFA_OPTIONAL=

# Vercel API: registers <slug>.sellycat.com and custom domains with the project (phase 1/6).
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Vercel Cron authentication (Authorization: Bearer <CRON_SECRET>) for /api/cron/*
CRON_SECRET=

# Seed (scripts/seed-staging.ts): demo owner and staff login on staging.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Mapbox (maps of redemption locations). Server token for geocoding; the public token (pk.…, restricted
# to your domains in Mapbox) appears in static map URLs. Without them the shop shows addresses and route links only.
MAPBOX_TOKEN=
MAPBOX_PUBLIC_TOKEN=

# Later phases (left empty until then):
# Stripe (phase 3/7): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_CONNECT_WEBHOOK_SECRET, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
# Mailgun (phase 4): MAILGUN_API_KEY, MAILGUN_DOMAIN=mail.sellycat.com, MAIL_FROM="Sellycat <noreply@mail.sellycat.com>"
# Apple Wallet (phase 5): APPLE_PASS_TYPE_ID, APPLE_TEAM_ID, APPLE_PASS_CERT, APPLE_PASS_KEY, APPLE_WWDR_CERT
# Google Wallet (phase 5): GOOGLE_WALLET_ISSUER_ID, GOOGLE_WALLET_SERVICE_ACCOUNT
# Sentry: SENTRY_DSN, NEXT_PUBLIC_SENTRY_DSN
